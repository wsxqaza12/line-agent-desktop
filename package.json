{
  "name": "line-agent-desktop",
  "productName": "LINE Agent Desktop",
  "version": "0.4.0-preview.1",
  "description": "A local companion connecting selected LINE chats to your own AI agent.",
  "author": "ChiChieh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-bridge.mjs",
    "runtime": "python3 scripts/prepare-runtime.py",
    "package:win": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "test:ui": "node scripts/test-ui.mjs",
    "runtime:mac": "node scripts/prepare-mac-runtime.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "lucide-react": "^0.577.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "io.github.lineagent.desktop",
    "artifactName": "LINE-Agent-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "build/mcp-server.cjs",
        "to": "bridge/mcp-server.cjs"
      },
      {
        "from": "build/THIRD_PARTY_LICENSES.txt",
        "to": "bridge/THIRD_PARTY_LICENSES.txt"
      },
      {
        "from": "skills/line-workboard",
        "to": "skills/line-workboard"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "runtime",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "LINE-Agent-Desktop-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.5",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "runtime-mac",
          "to": "runtime"
        }
      ],
      "icon": "assets/icon-mac.png"
    },
    "dmg": {
      "title": "LINE Agent Desktop",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
